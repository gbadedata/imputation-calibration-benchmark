process.executor = 'local'

profiles {
    test {
        params.gt         = 'data/derived/qc/nf_test/gt_test.vcf.gz'
        params.panel_a    = 'data/derived/qc/nf_test/panelA_test.vcf.gz'
        params.panel_b    = 'data/derived/qc/nf_test/panelB_test.vcf.gz'
        params.outdir     = 'data/derived/qc/nf_test/results'
        params.xmx_gb     = 4
        params.nthreads   = 2
    }
}
